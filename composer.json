{
    "name": "tomatophp/filament-tenancy",
    "type": "library",
    "description": "Tenancy multi-database integration for FilamentPHP",
    "keywords": [
        "php",
        "laravel",
        "tenancy",
        "multi-database",
        "multi-tenancy",
        "filamentphp",
        "filament-plugins",
        "tomatophp"
    ],
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "TomatoPHP\\FilamentTenancy\\": "src/",
            "TomatoPHP\\FilamentTenancy\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TomatoPHP\\FilamentTenancy\\Tests\\": "tests/src",
            "TomatoPHP\\FilamentTenancy\\Tests\\Database\\Factories\\": "tests/database/factories"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TomatoPHP\\FilamentTenancy\\FilamentTenancyServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "Fady Mondy",
            "email": "info@3x1.io"
        }
    ],
    "require": {
        "php": "^8.2",
        "stancl/tenancy": "^3.9",
        "tomatophp/console-helpers": "^1.1",
        "filament/filament": "^5.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^4.0|^5.0",
        "pestphp/pest-plugin-livewire": "^4.0|^5.0",
        "laravel/socialite": "^5.20"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "version": "5.0.0",
    "suggest": {
        "laravel/socialite": "Needed for the optional social sign up routes in routes/web.php"
    }
}
